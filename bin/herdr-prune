#!/bin/bash
# Prune herdr workspaces that have no running processes inside them.
# Scans /proc to find processes whose cwd falls under a workspace path.
#
# Usage: herdr-prune [--dry-run] [--keep-focused]

set -euo pipefail

SCRIPT="herdr-prune"
die() { echo "$SCRIPT: $*" >&2; exit 1; }
warn() { echo "$SCRIPT: $*" >&2; }

DRY_RUN=false
KEEP_FOCUSED=true
CONFIRM=true

for arg; do
  case "$arg" in
    --help|-h)
      echo "herdr-prune — close unused herdr workspaces"
      echo ""
      echo "Scans /proc for running processes and closes workspaces"
      echo "that have no process cwd inside them."  
      echo ""
      echo "Usage:"
      echo "  herdr-prune              interactive (asks before closing)"
      echo "  herdr-prune --dry-run    list candidates without closing"
      echo "  herdr-prune -y           close immediately, no prompt"
      echo ""
      echo "Options:"
      echo "  -h, --help       show this help"
      echo "  --dry-run        show what would be pruned, don't close"
      echo "  --keep-focused   preserve the focused workspace (default)"
      echo "  --no-keep-focused  allow pruning the focused workspace"
      echo "  -y, --yes        skip confirmation prompt"
      exit 0
      ;;
    --dry-run) DRY_RUN=true ; CONFIRM=false ;;
    --keep-focused) KEEP_FOCUSED=true ;;
    --no-keep-focused) KEEP_FOCUSED=false ;;
    --yes|-y) CONFIRM=false ;;
    *) die "unknown option: $arg (try --help)" ;;
  esac
done

# --- bail if herdr server isn't running ---

herdr status >/dev/null 2>&1 || die "herdr server is not running"

# --- gather all process cwds ---

echo "scanning /proc for process cwds ..." >&2
declare -A PROC_CWDS
for pid in /proc/[0-9]*; do
  pid="${pid#/proc/}"
  # skip kernel threads (no cmdline or empty cmdline)
  cmdline=$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null) || continue
  [[ -z "$cmdline" ]] && continue
  cwd=$(readlink "/proc/$pid/cwd" 2>/dev/null) || continue
  [[ -z "$cwd" ]] && continue
  PROC_CWDS["$cwd"]=1
done

echo "  found ${#PROC_CWDS[@]} distinct process cwds" >&2

# --- gather workspace paths ---

echo "collecting workspace pane paths ..." >&2

WORKSPACES=$(
  herdr workspace list 2>/dev/null | jq -r '
    .result.workspaces[]
    | [.workspace_id, .label, .focused]
    | @tsv
  '
)

CLOSED=0
KEPT=0
PRUNE_CANDIDATES=()

while IFS=$'\t' read -r ws_id label focused_str; do
  focused="${focused_str,,}"  # lowercase: "true" / "false"

  # skip the home workspace if focused
  if [[ "$label" == "~" ]]; then
    echo "  ~/home workspace — keeping" >&2
    KEPT=$((KEPT + 1))
    continue
  fi

  # --- collect all unique paths for this workspace ---
  PATHS=$(
    herdr pane list --workspace "$ws_id" 2>/dev/null \
    | jq -r '.result.panes[]
             | .cwd, .foreground_cwd
             | select(. != null and . != "")' \
    | sort -u
  )

  # also add the worktree checkout_path if present
  WT_PATH=$(
    herdr workspace get "$ws_id" 2>/dev/null \
    | jq -r '.result.workspace.worktree.checkout_path // empty'
  )
  if [[ -n "$WT_PATH" ]]; then
    PATHS=$(echo -e "$PATHS\n$WT_PATH" | sort -u)
  fi

  # if no paths, check if workspace has 0 panes → definitely prune
  if [[ -z "$PATHS" ]]; then
    echo "  $ws_id ($label) — no pane paths, pruning" >&2
    if ! $DRY_RUN; then
      herdr workspace close "$ws_id" 2>/dev/null || warn "failed to close $ws_id"
    fi
    CLOSED=$((CLOSED + 1))
    continue
  fi

  # --- check if any process cwd matches ---
  IN_USE=false

  # shellcheck disable=SC2016
  while IFS= read -r pane_path; do
    [[ -z "$pane_path" ]] && continue
    # normalize: remove trailing slash
    pane_path="${pane_path%/}"
    for proc_cwd in "${!PROC_CWDS[@]}"; do
      # check if the process cwd starts with the pane path
      if [[ "$proc_cwd" == "$pane_path" || "$proc_cwd" == "$pane_path"/* ]]; then
        IN_USE=true
        break 2
      fi
    done
  done <<< "$PATHS"

  if $DRY_RUN || $CONFIRM; then
    if $IN_USE; then
      echo "  $ws_id ($label) — has active processes, keeping" >&2
      KEPT=$((KEPT + 1))
    else
      echo "  $ws_id ($label) — NO processes found, candidate for pruning" >&2
      PRUNE_CANDIDATES+=("$ws_id|$label")
      CLOSED=$((CLOSED + 1))
    fi
  else
    if $IN_USE; then
      echo "  $ws_id ($label) — has active processes, keeping" >&2
      KEPT=$((KEPT + 1))
    else
      echo "  $ws_id ($label) — no processes found, pruning" >&2
      herdr workspace close "$ws_id" 2>/dev/null || warn "failed to close $ws_id"
      CLOSED=$((CLOSED + 1))
    fi
  fi
done <<< "$WORKSPACES"

echo "" >&2

if $DRY_RUN; then
  echo "dry-run: would close $CLOSED workspace(s), keep $KEPT" >&2
elif $CONFIRM && [[ ${#PRUNE_CANDIDATES[@]} -gt 0 ]]; then
  echo "candidates for pruning:" >&2
  for cand in "${PRUNE_CANDIDATES[@]}"; do
    IFS='|' read -r wid wl <<< "$cand"
    echo "  $wid ($wl)" >&2
  done
  echo "" >&2
  read -r -p "Close these ${#PRUNE_CANDIDATES[@]} workspace(s)? [y/N] " reply
  if [[ "$reply" =~ ^[yY] ]]; then
    for cand in "${PRUNE_CANDIDATES[@]}"; do
      IFS='|' read -r wid wl <<< "$cand"
      echo "  closing $wid ($wl) ..." >&2
      herdr workspace close "$wid" 2>/dev/null || warn "failed to close $wid"
    done
    echo "closed ${#PRUNE_CANDIDATES[@]} workspace(s)" >&2
  else
    echo "aborted" >&2
  fi
elif ! $DRY_RUN; then
  echo "done: closed $CLOSED workspace(s), kept $KEPT" >&2
fi