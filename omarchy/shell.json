{
  "version": 1,
  "idle": {
    "screensaver": 150,
    "lock": 300
  },
  "bar": {
    "position": "top",
    "transparent": true,
    "centerAnchor": "omarchy.clock",
    "layout": {
      "left": [
        {
          "id": "omarchy.menu"
        },
        {
          "id": "omarchy.workspaces"
        },
        {
          "id": "omarchy.active-window"
        }
      ],
      "center": [
        {
          "id": "omarchy.indicators"
        },
        {
          "id": "omarchy.clock",
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n—\nmm"
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "io.github.abdxdev.onscreen-keyboard"
        },
        {
          "id": "omarchy.system-update"
        },
        {
          "id": "io.github.ilyazar.keyboard-layout",
          "perWindowLayouts": true
        }
      ],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "felixzsh.key-visualizer"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "davedes.workspace-restorer"
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.power"
        }
      ]
    }
  },
  "plugins": [
    {
      "id": "cgranier.dojo"
    },
    {
      "id": "cog.notifications"
    }
  ],
  "disabledPlugins": [
    "omarchy.keyboard-layout",
    "omarchy.notifications"
  ],
  "cloneSourceRestores": [
    "io.github.ilyazar.keyboard-layout",
    "cog.notifications"
  ]
}
