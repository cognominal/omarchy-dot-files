# Browser profiles/caches — large, contain cookies/saved logins, regenerated by the apps
/chromium/
/BraveSoftware/
/google-chrome/
/google-chrome-beta/
/google-chrome-unstable/
/microsoft-edge/
/microsoft-edge-dev/

# GitHub CLI account/host metadata — auth-adjacent, not shareable config
/gh/

# Desktop session state / IPC sockets / private caches — machine-specific, not config
/dconf/
/fcitx/
/ibus/
/pulse/
/procps/

# Backup made during a migration, not a dotfile
/nvim.backup.*/

# Runtime state, logs, sockets — regenerated, not config
/herdr/*.log
/herdr/*.sock
/herdr/session.json
/herdr/release-notes.json
/omarchy/workspace-restorer/

# General caches
**/.cache/
**/node_modules/
